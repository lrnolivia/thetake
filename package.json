{
  "name": "the-take",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-ocr.mjs && vite",
    "test": "node --experimental-strip-types scripts/test-pay.mjs",
    "build": "node scripts/prepare-ocr.mjs && tsc --noEmit && vite build && node scripts/copy-pwa-assets.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test:inventory": "node --test scripts/test-inventory.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "jose": "^6.2.12",
    "tesseract.js": "^7.0.0"
  }
}
